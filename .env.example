# ══════════════════════════════════════════════════════════════
# THEFVC.IS — Environment Variables
# Copy to .env and fill in values before starting the server.
# ══════════════════════════════════════════════════════════════

# ─── Security ────────────────────────────────────────────────
# REQUIRED — Server will refuse to start without this.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Admin Bootstrap ─────────────────────────────────────────
# Used for initial admin user creation during migration.
# If not set, admin bootstrap is skipped (existing admin preserved).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Tax Compliance ──────────────────────────────────────────
# Payer's EIN for 1099-NEC forms (format: XX-XXXXXXX)
PAYER_TIN=

# ─── Database ────────────────────────────────────────────────
DATABASE_PATH=./data/thefvc.db

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SESSION_SECRET=
