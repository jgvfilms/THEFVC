# ══════════════════════════════════════════════════════════════
# THEFVC.IS — Environment Variables
# Copy to .env and fill in values before starting the server.
# ══════════════════════════════════════════════════════════════

# ─── Security ────────────────────────────────────────────────
# REQUIRED — Server will refuse to start without this.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Admin Bootstrap ─────────────────────────────────────────
# Used for initial admin user creation during migration.
# If not set, admin bootstrap is skipped (existing admin preserved).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Tax Compliance ──────────────────────────────────────────
# Payer's EIN for 1099-NEC forms (format: XX-XXXXXXX)
PAYER_TIN=

# ─── Database ────────────────────────────────────────────────
DATABASE_PATH=./data/thefvc.db

# ─── Rate Limiting ───────────────────────────────────────────
# Directory for the rate-limit persistence file. On hosts with an
# ephemeral filesystem (e.g. Railway), point this at the same mounted
# volume as DATABASE_PATH's parent directory, or resets will silently
# stop surviving redeploys.
RATE_LIMIT_DIR=./data

# Number of reverse-proxy hops in front of the app, i.e. how many
# trailing X-Forwarded-For entries were appended by proxies YOU control.
# MUST match the real topology or rate limiting breaks silently:
#   too low  -> keys on a proxy IP instead of the client. On Railway with
#               the default of 1, counts scatter across rotating edge IPs
#               and the limiter never fires (verified in production).
#   too high -> reads client-supplied values, so callers can spoof their
#               IP to dodge limits or get someone else blocked.
# Known values:  Railway = 2   |   single nginx reverse proxy = 1
# To verify: make a request, then check which key shows up in
# $RATE_LIMIT_DIR/.rate-limits.json — it must be the real client IP.
TRUSTED_PROXY_HOPS=1

# ─── Stripe ──────────────────────────────────────────────────
# Use sk_test_/pk_test_ keys from a Stripe sandbox for testing.
# The invoicing module refuses to send if this doesn't start with "sk_".
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the Dashboard webhook endpoint in deployed
# environments. Signature verification fails closed without it.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ─── Invoicing ───────────────────────────────────────────────
# Reply-to on automated invoice follow-ups. Must reach a human — every
# reminder tells the recipient to reply here if something looks wrong.
INVOICE_REPLY_TO=

# ─── Email (Resend) ──────────────────────────────────────────
# Without this the app still boots, but queued emails (including invoice
# reminders) fail individually with a clear error.
RESEND_API_KEY=
FROM_EMAIL=noreply@thefvc.is

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SESSION_SECRET=
